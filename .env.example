# Copy this file to .env before starting the stack. "make setup" does it for you.

# Leave USE_MOCK_SHOPIFY set to true to run against the built in catalog.
# Set it to false once the application is installed into a development store.
USE_MOCK_SHOPIFY=true

SHOPIFY_STORE_DOMAIN=your-development-store.myshopify.com
SHOPIFY_API_VERSION=2026-07

# From the application you create in the Partner dashboard. The client secret is
# also the value Shopify signs webhooks with.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APPLICATION_URL=http://localhost:8000
SHOPIFY_SCOPES=read_products,write_products,read_inventory

# Any value works while you are testing with "make webhook", as long as the
# sender and the application agree on it. Set it to the client secret once you
# are receiving real webhooks.
SHOPIFY_WEBHOOK_SECRET=local-development-secret

# Optional: skip the installation flow by pasting an access token here instead.
SHOPIFY_ADMIN_ACCESS_TOKEN=

ALLOWED_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=10
